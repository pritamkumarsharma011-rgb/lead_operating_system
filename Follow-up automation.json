    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// NOTE: field names exactly waise hi use karo jo output me dikh rahe hain\nconst lastTimeStr = item.TIme_tracking;   // yahan T I m e capital T, capital I hai\nconst currentTimeStr = item.last_Time;\n\nif (!lastTimeStr || !currentTimeStr) {\n  return [{\n    json: {\n      ...item,\n      diffMin: null,\n      isTimeExceeded: false,\n      error: 'Missing time fields'\n    }\n  }];\n}\n\nconst lastTime = new Date(lastTimeStr);\nconst now = new Date(currentTimeStr);\n\n// safety: invalid date check\nif (isNaN(lastTime.getTime()) || isNaN(now.getTime())) {\n  return [{\n    json: {\n      ...item,\n      diffMin: null,\n      isTimeExceeded: false,\n      error: 'Invalid date parse'\n    }\n  }];\n}\n\nconst diffMs = now - lastTime;\nconst diffMin = Math.floor(diffMs / 60000);\n\n// testing ke liye 5 min, production me 30\nconst isTimeExceeded = diffMin > 3;\n\nreturn [{\n  json: {\n    ...item,\n    diffMin,\n    isTimeExceeded\n  }\n}];"
      },
